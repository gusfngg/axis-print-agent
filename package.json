{
  "name": "axis-print-agent",
  "version": "1.2.0",
  "private": true,
  "description": "Agente local de impressao da notinha de caixa do Axis ERP (ESC/POS 80mm via spooler Windows).",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "build:exe": "npm run build && pkg dist/main.cjs --config pkg.config.json --targets node20-win-x64 --output dist/axis-print-agent.exe",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.0",
    "@thiagoelg/node-printer": "^0.6.2",
    "fastify": "^5.2.0",
    "node-thermal-printer": "^4.4.0",
    "pino": "^9.5.0",
    "rotating-file-stream": "^3.2.9",
    "systray2": "^2.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@yao-pkg/pkg": "^6.3.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
